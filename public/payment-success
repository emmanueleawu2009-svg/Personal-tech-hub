<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Payment Status | Personal Tech Hub</title><link rel="stylesheet" href="css/style.css"></head>
<body><main class="section section-dark" style="min-height:100vh;display:grid;place-items:center"><div class="container" style="max-width:700px;text-align:center"><p class="kicker">PAYMENT STATUS</p><h1 style="font-size:clamp(3rem,8vw,6rem)">Checking your payment.</h1><p id="status" style="color:#b3bfce;margin:20px auto;max-width:560px">Please wait while the server confirms the transaction.</p><a class="btn btn-primary" href="/#contact">Back to Personal Tech Hub</a></div></main><script>const params=new URLSearchParams(location.search);const ref=params.get('reference');const el=document.getElementById('status');if(!ref){el.textContent='No payment reference was provided. You can return to the site and send your project request again.';}else{fetch('/api/payments/verify/'+encodeURIComponent(ref)).then(r=>r.json()).then(data=>{if(data.ok&&data.status==='success'){el.textContent='Payment confirmed. Your project request is now on record. Keep your reference: '+data.reference;}else{el.textContent='The payment status is '+(data.status||'not confirmed yet')+'. Keep your reference and contact Personal Tech Hub if you need help: '+data.reference;}}).catch(()=>{el.textContent='We could not confirm the payment automatically. Please keep your Paystack reference and contact Personal Tech Hub.'});}</script></body></html>
